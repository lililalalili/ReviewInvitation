# Local runtime directory (outside git) that stores operational files.
REVIEW_INVITATION_BASE_DIR=D:\Agents\ReviewInvitation

# Optional PubMed config
PUBMED_EMAIL=your_email@example.com
PUBMED_API_KEY=

# LLM (DeepSeek)
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Search provider
SEARCH_PROVIDER=fake
SEARCH_API_KEY=replace_me
BRAVE_SEARCH_API_KEY=replace_me

# Outlook send account
OUTLOOK_SEND_ACCOUNT=nsb@ion.ac.cn

# Safe defaults for local bootstrap
DRY_RUN=true
